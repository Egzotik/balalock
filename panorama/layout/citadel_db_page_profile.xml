<!--
  POSTMORTEM — override of panorama/layout/citadel_db_page_profile.xml

  WHY THIS FILE, AND NOT citadel_db_page_home.xml
  The home page was entry point A in build 2. It is replaced by the profile page,
  because the profile is the one dashboard page that already holds BOTH data sources
  the report needs, with no network involved:

    {d:player_stats_state}  -> games_played, games_won, last_hits, denies,
                               commend_count, and a per-hero breakdown in #HeroList
    {d:match_history_state} -> #MatchHistoryArea with the player's own match blocks
                               (CitadelMatchHistoryBlockLarge), each carrying
                               outcome, mode, hero, duration, start time and net worth

  The home page has neither. A button there could only ever show a shell.

  In-game match details, and why the API is no longer needed
  Clicking "View Details" on a past match in the history opens the full post-game
  scoreboard for that match - verified in game on build 25763945. The full per-player
  stat line only exists on that page, so the profile button does this:

    pick a match block -> dispatch its viewDetails activation
                      -> the game navigates to CitadelPostGameNew
                      -> our override of that page opens the report with real data

  So match history and match breakdowns both come from the game. No fetch, no CEF
  bridge, no api.deadlock-api.com. The CEF transport stays in the build only for the
  two things the game genuinely does not expose - Counter Buys and full FAM - and is
  off by default. See docs/TRANSPORT.md.

  MERGE BASE
  Deadlock, game build 25763945 (appmanifest 1422450). Pure vanilla + two additions.

  HARD RULES
  1. ADD ONLY. Never remove or rename a vanilla child.
  2. Keep the _c suffix on every <include>; the game resolves compiled names only.
  3. pm_root.vcss is included here because the overlay is created at runtime in THIS
     file's context, and a panel only sees the stylesheets its own context includes.
-->
<root>
	<styles>
		<include src="s2r://panorama/styles/citadel_base_styles.vcss_c" />
		<include src="s2r://panorama/styles/citadel_db_page_shared.vcss_c" />
		<include src="s2r://panorama/styles/citadel_db_page_profile.vcss_c" />
		<include src="s2r://panorama/styles/postmortem/pm_button.vcss_c" />
		<include src="s2r://panorama/styles/postmortem/pm_root.vcss_c" />
	</styles>
	<scripts>
		<include src="s2r://panorama/scripts/postmortem/pm_text.vjs_c" />
		<include src="s2r://panorama/scripts/postmortem/pm_analysis.vjs_c" />
		<include src="s2r://panorama/scripts/postmortem/pm_compat.vjs_c" />

		<include src="s2r://panorama/scripts/postmortem/pm_data.vjs_c" />
		<include src="s2r://panorama/scripts/postmortem/pm_net.vjs_c" />
		<include src="s2r://panorama/scripts/postmortem/pm_api.vjs_c" />
		<include src="s2r://panorama/scripts/postmortem/pm_probe.vjs_c" />
		<include src="s2r://panorama/scripts/postmortem/pm_core.vjs_c" />
	</scripts>
	<snippets>
		<snippet name="MatchBlockBig">
			<Panel class="MatchBlockBig">
				<Panel class="teamStripe" />
				<Panel class="gameContent">
					<Panel class="gameInfo">
						<Panel id="gameResultRow">
							<Label class="gameMode" text="{s:match_mode}" />
							<Label class="gameResult" text="{s:match_outcome}" />
						</Panel>
						<Label class="heroName" text="{g:citadel_hero_name:hero_id}" />
						<Label class="gameDuration" text="{g:citadel_match_time:match_duration}" />
						<Label class="gameDate" text="{t:s:t:m:match_start_time}" />
					</Panel>
					<CitadelHeroImage id="HeroImage" class="heroImg" />
					<Label class="gameNetworth" text="{s:game_networth_label}" />
				</Panel>
				<Panel id="Overlay">
					<Panel class="viewDetails">
						<Label text="#Citadel_Profile_MatchHistory_ViewDetails" />
						<Panel class="arrowIcon" />
					</Panel>
				</Panel>
			</Panel>
		</snippet>
		<snippet name="MatchBlockMini">
			<Panel class="gameMiniBlock">
				<Panel class="teamStripe" />
				<Label class="gameResultShort" text="{s:match_outcome}" />
				<CitadelHeroImage id="HeroImage" class="heroImg" />
				<Panel id="Overlay">
					<Panel class="viewDetails">
						<Panel class="arrowIcon" />
					</Panel>
				</Panel>
			</Panel>
		</snippet>
		<snippet name="HeroRow">
			<Panel class="heroRow">
				<Panel id="HeroRowBackground" />
				<CitadelHeroImage id="HeroRowImage" heroimagestyle="small" />
				<Label class="heroRowName" text="{s:hero_row_name}" />
			</Panel>
		</snippet>
		<snippet name="BlockStat">
			<Panel class="BlockStat">
				<Panel class="blockBacker" />
				<Panel class="StatIcon" />
				<Label class="statValue" text="{i:stat_value}" />
				<Panel class="labelContainer">
					<Label class="statLabel" text="{s:stat_name}" />
				</Panel>
			</Panel>
		</snippet>
		<snippet name="SeasonalAchievement">
			<Panel class="SeasonalAchievement">
				<Label id="AchievementCaption" text="{s:seasonal_achievement_caption}" />
			</Panel>
		</snippet>
	</snippets>
	<CitadelProfilePage class="DashboardPage" oncancel="PMOnCancel();" dashboardclass="isShowingProfilePage">
		<AsyncDataPanel class="AsyncContents" state="{d:player_stats_state}">
			<Panel class="AsyncSuccessContainer">
				<CitadelHeroScenePanelNew id="HeroScenePanel" heroscenestyle="Profile" />
				<Panel class="MainContents">
					<Panel class="LeftPanel">
						<Panel class="ProfileSection">
							<CitadelAvatarImage id="SelfImage" />
							<Panel id="ProfileInfo">
								<CitadelUserName id="SelfName" />
								<Panel class="SteamInfo">
									<Button id="ViewSteamProfile" onmouseout="UIHideTextTooltip();" onmouseover="UIShowTextTooltip( #Citadel_Profile_ViewSteamProfile );">
										<Image src="s2r://panorama/images/profile/icon_steam_psd.vtex" />
									</Button>
									<Label class="FriendID" text="#Citadel_Profile_FriendID" onmouseover="UIShowTextTooltip( #Citadel_Profile_CopyFriendCode )" onmouseout="UIHideTextTooltip()" onactivate="CitadelProfileCopyFriendCode()" />
								</Panel>
								<Button id="ForumButton" onactivate="CitadelJoinForum()">
									<Panel class="ForumIcon buttonIcon" />
									<Label class="defaultText" text="#Citadel_JoinForum_ViewInfo" />
								</Button>
							</Panel>
						</Panel>
					</Panel>
					<Panel class="RightPanel">
						<AsyncDataPanel class="AsyncMatchHistory" state="{d:match_history_state}" error-text="#Citadel_ProfileMatchHistory_Failed">
							<Panel id="MatchHistoryArea" class="AsyncSuccessContainer">
								<Panel class="titleArea">
									<Label id="matchHistoryLabel" class="smallTitle" text="#Citadel_Profile_MatchHistory" onactivate="CitadelProfileShowMatchHistoryTab( 0 )" />
									<Label id="showcaseLabel" class="smallTitle" text="#Citadel_Profile_Showcase" onactivate="CitadelProfileShowMatchHistoryTab( 1 )" />
									<Panel id="MatchHistoryButton">
										<Label class="smallTitle" text="#Citadel_Profile_MatchHistory_ViewAll" />
										<Panel id="allHistoryIcon" />
									</Panel>
									<!-- POSTMORTEM addition: entry point A. Sits next to "View All",
									     because it is the same act on the same data: pick a match,
									     then look at it. Starts collapsed; pm_core.js reveals it only
									     after the compatibility check passes and it has measured that
									     the overlay has room to render. -->
									<Button id="PM_ProfileButton" class="PMButton" onactivate="PMOpenOverlay();" onmouseover="UIShowTextTooltip( &quot;Match breakdowns from your own history&quot; );" onmouseout="UIHideTextTooltip();">
										<Panel class="PMButtonUnderline" />
										<Label class="PMButtonLabel" text="POSTMORTEM" />
									</Button>
								</Panel>
								<Panel id="MatchHistoryList">
									<Panel id="MatchBlockBigContainer" />
									<Panel id="MatchBlockMiniContainer" class="MiniMatchBlock" />
								</Panel>
								<Panel id="ShowcaseList" />
							</Panel>
						</AsyncDataPanel>
						<Panel id="GamesPlayed">
							<Panel id="StatsContent">
								<Panel id="HeroList" />
								<Panel id="StatsBlock">
									<Panel id="StatsTitle">
										<Label class="statSectionLabel" text="#Citadel_Profile_Stats_TitleSection" />
										<Label class="statSectionName" text="{s:stat_section_name}" />
									</Panel>
									<Panel id="StatsLeft">
										<Panel class="StatRow">
											<Panel id="GamesPlayedContainer" class="TextStat largeStat">
												<Label class="statValue" text="{i:games_played}" />
												<Label class="statLabel" text="#Citadel_Profile_Stats_GamesPlayed:f" />
											</Panel>
											<Panel id="GamesWonContainer" class="TextStat largeStat">
												<Label class="statValue" text="{i:games_won}" />
												<Label class="statLabel" text="#Citadel_Profile_Stats_GamesWon:f" />
											</Panel>
										</Panel>
										<Panel class="StatRow">
											<Panel id="LastHitsContainer" class="TextStat">
												<Label class="statValue" text="{i:last_hits}" />
												<Label class="statLabel" text="#Citadel_Profile_Stats_LastHits:f" />
											</Panel>
											<Panel id="DeniesContainer" class="TextStat">
												<Label class="statValue" text="{i:denies}" />
												<Label class="statLabel" text="#Citadel_Profile_Stats_Denies:f" />
											</Panel>
										</Panel>
										<Panel class="StatRow">
											<Panel id="CommendsContainer" class="TextStat">
												<Label class="statValue" text="{i:commend_count}" />
												<Label class="statLabel" text="#Citadel_Profile_Stats_Commends:f" />
											</Panel>
										</Panel>
									</Panel>
									<Panel id="StatsRight" />
								</Panel>
							</Panel>
						</Panel>
					</Panel>
				</Panel>
			</Panel>
		</AsyncDataPanel>
	</CitadelProfilePage>
</root>